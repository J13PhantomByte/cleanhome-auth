# Supabase Configuration
# Dapatkan dari Supabase Dashboard: Project Settings -> API
# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (safe for browser frontend client)
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here
